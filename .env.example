# ============================================================
#  Mẫu biến môi trường cho Day 26 lab (MCP vs Function Calling)
#  Copy file này thành `.env` ở đúng thư mục rồi điền giá trị thật.
#  KHÔNG commit file `.env` (đã có trong .gitignore).
# ============================================================

# ---------- OpenCode Go (LLM cho lab 01 + 04) ----------
# Model chính: step-5-preview-free. Fallback: deepseek-v4.1-flash (reasoning thấp/vừa).
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_SESSION_ID=day26-minh-001
OPENCODE_MODEL=step-5-preview-free
OPENCODE_FALLBACK_MODEL=deepseek-v4.1-flash

# ---------- WeatherAPI.com (lab 04 — MCP server lấy dữ liệu thật) ----------
# Đăng ký free: https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=your_weatherapi_key_here

# ---------- MCP client / server ----------
MCP_SERVER_URL=http://localhost:8085/mcp
PORT=8085
MCP_AUTH_TOKEN=dev-token-abc123

# ---------- (tuỳ chọn) Gemini — chỉ cần nếu KHÔNG dùng OpenCode Go ----------
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
